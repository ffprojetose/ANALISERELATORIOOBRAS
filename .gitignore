# ============================================
# Dados de obras: documentos de clientes e arquivos gerados.
# Nunca versionar — protege a confidencialidade (ver CLAUDE.md, Regras Absolutas).
# Observação: o projeto ainda não é um repositório git; este arquivo prepara
# o terreno para quando o versionamento for iniciado.
# ============================================
obras/*/entrada/**
obras/*/processamento/**
obras/*/saida/**
obras/*/docs/**

# ============================================
# Arquivos de ambiente, temporários e de sistema
# ============================================
.env
.env.*
*.tmp
*.log
~$*
Thumbs.db
.DS_Store
__pycache__/
*.pyc
node_modules/

# Configurações locais do Claude Code (específicas desta máquina/usuário)
.claude/settings.local.json

# Mantém a estrutura de pastas e os placeholders no controle de versão
!obras/*/entrada/**/
!obras/*/processamento/**/
!obras/*/saida/**/
!obras/*/docs/**/
!**/.gitkeep
